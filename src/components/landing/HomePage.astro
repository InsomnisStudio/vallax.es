---
import WallapopLogo from "../../images/wallapop.png";
import VintedLogo from "../../images/vinted.png";
import MilanunciosLogo from "../../images/milanuncios.png";
import TodocoleccionLogo from "../../images/todocoleccion.png";
import TelegramLogo from "../../images/telegram-logo.png";
import PlaystationImage from "../../images/hero/playstation.jpg";
import SwitchImage from "../../images/hero/nintendo-switch.jpg";
import XboxImage from "../../images/hero/xbox.jpg";
import EbikeListingImage from "../../images/hero/app/listing-ebike.jpg";
import HeadphonesListingImage from "../../images/hero/app/listing-headphones.jpg";
import SwitchOledListingImage from "../../images/hero/app/listing-switch-oled.jpg";
import SmartphoneStockImage from "../../images/hero/app/stock-smartphone.jpg";
import ScooterStockImage from "../../images/hero/app/stock-scooter.jpg";
import EreaderStockImage from "../../images/hero/app/stock-ereader.jpg";
import type { Locale, Translation } from "../../i18n";
import { platformPages, solutionPages } from "../../data/seo-pages";
import { featuredReviews, googlePlayUrl, reviewsUi } from "../../data/reviews";
import { aiAssistantGuideSlug, aiAssistantUi, aiAssistantUrl } from "../../data/ai-assistant";

interface Props {
    lang: Locale;
    t: Translation;
    variant?: "home" | "ad";
}

const { lang, t, variant = "home" } = Astro.props as Props;
const isAd = variant === "ad";
const hero = isAd ? t.adHero : t.hero;
const androidStoreHref = "https://play.google.com/store/apps/details?id=com.insomnis.vallax";
// Paid-ads landing tags Play installs so they show up as a UTM campaign in Play Console.
const androidAppHref = isAd
    ? `${androidStoreHref}&referrer=${encodeURIComponent("utm_source=meta&utm_medium=paid&utm_campaign=Instagram ads")}`
    : androidStoreHref;
// Paid-ads landing uses an App Store Connect campaign link to attribute iOS downloads.
const iosAppHref = isAd
    ? "https://apps.apple.com/app/apple-store/id6793169829?pt=129201372&ct=Instagram%20ads&mt=8"
    : "https://apps.apple.com/es/app/vallax/id6793169829";
const communityHref = "https://t.me/vallax_group";
const docsHref = `/${lang}/docs/`;
const featureIcons = ["layers", "bolt", "tune", "auto_awesome"];
const heroTitleWords = hero.title.split(" ");
const heroTitleLead = heroTitleWords.slice(0, -3).join(" ");
const heroTitleAccent = heroTitleWords.slice(-3).join(" ");
const localizedUi = {
    es: {
        appStoreOverline: "Descargalo en",
        docsCta: "Ver documentacion",
        playStoreOverline: "Consiguelo en",
        lockDate: "Mar 1 abr",
        firstTime: "hace 30 s",
        secondTime: "hace 8 s",
        thirdTime: "ahora",
        bikeSearch: "Bici eléctrica",
        headphonesSearch: "Cascos Sony",
        scooterSearch: "Moto 125",
    },
    en: {
        appStoreOverline: "Download on the",
        docsCta: "View documentation",
        playStoreOverline: "Get it on",
        lockDate: "Tue Apr 1",
        firstTime: "30s ago",
        secondTime: "8s ago",
        thirdTime: "now",
        bikeSearch: "E-bike",
        headphonesSearch: "Sony headphones",
        scooterSearch: "125cc scooter",
    },
    fr: {
        appStoreOverline: "Telechargez sur",
        docsCta: "Voir la documentation",
        playStoreOverline: "Disponible sur",
        lockDate: "Mar 1 avr.",
        firstTime: "il y a 30 s",
        secondTime: "il y a 8 s",
        thirdTime: "maintenant",
        bikeSearch: "Vélo élec",
        headphonesSearch: "Casque Sony",
        scooterSearch: "Scooter 125",
    },
    it: {
        appStoreOverline: "Scarica su",
        docsCta: "Apri la documentazione",
        playStoreOverline: "Disponibile su",
        lockDate: "Mar 1 apr",
        firstTime: "30 s fa",
        secondTime: "8 s fa",
        thirdTime: "ora",
        bikeSearch: "Bici elettrica",
        headphonesSearch: "Cuffie Sony",
        scooterSearch: "Scooter 125",
    },
    pl: {
        appStoreOverline: "Pobierz w",
        docsCta: "Zobacz dokumentacje",
        playStoreOverline: "Pobierz z",
        lockDate: "Wt 1 kwi",
        firstTime: "30 s temu",
        secondTime: "8 s temu",
        thirdTime: "teraz",
        bikeSearch: "E-rower",
        headphonesSearch: "Słuchawki",
        scooterSearch: "Skuter 125",
    },
}[lang];
// Final stack order top-to-bottom: third (newest), second, first (oldest).
// The ad landing shows real listings named by the search that triggered them.
const heroNotifications = isAd
    ? [
          {
              stackClass: "notification-card-third border-white/10 bg-white/8",
              platform: "Vinted",
              time: localizedUi.thirdTime,
              title: localizedUi.headphonesSearch,
              listing: "Sony Extra Bass",
              price: 40,
              image: HeadphonesListingImage,
              alt: "Sony Extra Bass",
          },
          {
              stackClass: "notification-card-first border-white/15 bg-white/14",
              platform: "Wallapop",
              time: localizedUi.firstTime,
              title: localizedUi.bikeSearch,
              listing: "Rockrider E-ST 500",
              price: 750,
              image: EbikeListingImage,
              alt: "Rockrider E-ST 500",
          },
          {
              stackClass: "notification-card-second border-white/12 bg-white/10",
              platform: "Wallapop",
              time: localizedUi.secondTime,
              title: "Nintendo Switch",
              listing: "Switch OLED",
              price: 193,
              image: SwitchOledListingImage,
              alt: "Nintendo Switch OLED",
          },
      ]
    : [
          {
              stackClass: "notification-card-third border-white/10 bg-white/8",
              platform: "Milanuncios",
              time: localizedUi.thirdTime,
              title: "Xbox Series X",
              price: 280,
              image: XboxImage,
              alt: "Xbox Series X",
          },
          {
              stackClass: "notification-card-first border-white/15 bg-white/14",
              platform: "Wallapop",
              time: localizedUi.firstTime,
              title: "Playstation 5",
              price: 350,
              image: PlaystationImage,
              alt: "Playstation 5",
          },
          {
              stackClass: "notification-card-second border-white/12 bg-white/10",
              platform: "Vinted",
              time: localizedUi.secondTime,
              title: "Nintendo Switch",
              price: 100,
              image: SwitchImage,
              alt: "Nintendo Switch",
          },
      ];
// Mobile ad landing: the phone mockup sits below the fold, so a single
// notification card above the CTA slowly cycles through categories.
const priceFormatter = new Intl.NumberFormat(lang, { maximumFractionDigits: 0 });
const tickerNotifications = [
    { platform: "Vinted", title: localizedUi.headphonesSearch, price: 40, image: HeadphonesListingImage },
    { platform: "Wallapop", title: localizedUi.bikeSearch, price: 750, image: EbikeListingImage },
    { platform: "Milanuncios", title: localizedUi.scooterSearch, price: 1200, image: ScooterStockImage },
    { platform: "Wallapop", title: "Nintendo Switch", price: 193, image: SwitchOledListingImage },
    { platform: "Vinted", title: "Kindle", price: 50, image: EreaderStockImage },
    { platform: "Wallapop", title: "iPhone", price: 180, image: SmartphoneStockImage },
];
const reviewCopy = reviewsUi[lang];
const heroReview =
    featuredReviews.findLast((review) => review.language === lang) ??
    featuredReviews.find((review) => review.language === "en")!;
const aiCopy = aiAssistantUi[lang];
const aiGuideHref = `/${lang}/${aiAssistantGuideSlug}/`;
const reviewDateFormatter = new Intl.DateTimeFormat(lang, {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
});
const platforms = [
    {
        name: "Wallapop",
        logo: WallapopLogo,
        href: "https://es.wallapop.com/",
    },
    {
        name: "Vinted",
        logo: VintedLogo,
        href: "https://www.vinted.es/",
    },
    {
        name: "Todocoleccion",
        logo: TodocoleccionLogo,
        href: "https://www.todocoleccion.net/",
    },
    {
        name: "Milanuncios",
        logo: MilanunciosLogo,
        href: "https://www.milanuncios.com/",
    },
];
const seoPlatformLinks = platformPages.slice(0, 4).map((page) => ({
    href: `/${lang}/platforms/${page.slug}/`,
    title: page.locale[lang].title,
}));
const seoSolutionLinks = solutionPages.slice(0, 3).map((page) => ({
    href: `/${lang}/solutions/${page.slug}/`,
    title: page.locale[lang].title,
}));
---

<section
    id="download-app"
    class:list={[
        "relative overflow-hidden px-6 pb-20 md:px-16 md:pb-40 md:pt-48",
        isAd ? "pt-24" : "pt-32",
    ]}
>
    <div
        class="hero-glow absolute left-1/2 top-0 -z-10 h-full w-full -translate-x-1/2"
    ></div>
    <div class="mx-auto grid max-w-7xl items-center gap-16 lg:grid-cols-12">
        <div class:list={["lg:col-span-7", isAd ? "space-y-6 md:space-y-10" : "space-y-10"]}>
            <div
                class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-primary"
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex h-2 w-2 rounded-full bg-primary"
                    ></span>
                </span>
                {hero.availability}
            </div>
            <h1
                class:list={[
                    "font-black leading-[1.05] tracking-tight text-white md:text-7xl",
                    isAd ? "text-4xl sm:text-5xl" : "text-5xl",
                ]}
            >
                {heroTitleLead}
                <span class="gradient-text"> {heroTitleAccent}</span>.
            </h1>
            <p
                class:list={[
                    "max-w-2xl leading-relaxed text-on-surface-variant md:text-xl",
                    isAd ? "text-base sm:text-lg" : "text-lg",
                ]}
            >
                {hero.description}
            </p>
            {isAd && (
                <div class="relative h-16 lg:hidden" aria-hidden="true">
                    {tickerNotifications.map((notification, index) => (
                        <div class:list={["hero-ticker-item absolute inset-0 flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.06] px-3 backdrop-blur-xl", index === 0 && "is-active"]}>
                            <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0C1014] ring-1 ring-white/10">
                                <img src="/favicon-d.svg" alt="" class="h-4 w-4 object-contain" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2 text-[11px]">
                                    <p class="truncate font-semibold text-white/70">
                                        Vallax · <span class="text-white/50">{notification.platform}</span>
                                    </p>
                                    <p class="shrink-0 text-white/45">{localizedUi.thirdTime}</p>
                                </div>
                                <p class="truncate text-sm font-semibold text-white">
                                    {notification.title}
                                    <span class="font-medium text-white/60"> · {priceFormatter.format(notification.price)} €</span>
                                </p>
                            </div>
                            <img src={notification.image.src} alt="" class="h-10 w-10 shrink-0 rounded-lg object-cover" />
                        </div>
                    ))}
                    <script is:inline>
                        (() => {
                            const items = document.querySelectorAll(".hero-ticker-item");
                            if (items.length < 2 || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                                return;
                            }

                            let current = 0;
                            setInterval(() => {
                                if (document.hidden) {
                                    return;
                                }

                                const leaving = items[current];
                                leaving.classList.replace("is-active", "is-leaving");
                                setTimeout(() => leaving.classList.remove("is-leaving"), 600);
                                current = (current + 1) % items.length;
                                items[current].classList.add("is-active");
                            }, 4000);
                        })();
                    </script>
                </div>
            )}
            {isAd && (
                <a
                    id="hero-mobile-cta"
                    class="mobile-store-cta flex w-full items-center justify-center gap-2 rounded-2xl bg-primary px-6 py-4 text-lg font-extrabold text-on-primary shadow-lg shadow-primary/20 transition active:scale-[0.98] sm:hidden"
                    href={androidAppHref}
                    data-app-store="android"
                    target="_blank"
                    rel="noreferrer"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    <span>{t.adHero.primaryCta}</span>
                </a>
            )}
            <div
                class:list={[
                    "mt-6 flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:justify-start",
                    isAd ? "hidden sm:flex" : "flex",
                ]}
            >
                <a
                    class="store-badge store-badge-ios inline-flex items-center rounded-lg border border-white/10 bg-[#161616] px-4 py-2 text-xl tracking-wider text-white transition hover:border-primary/40 hover:bg-[#1d1d1d] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    href={iosAppHref}
                    data-app-store="ios"
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`iOS - ${localizedUi.appStoreOverline} App Store`}
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="store-badge-icon mr-2 inline h-9 w-9 shrink-0 fill-current"
                        viewBox="0 0 22.773 22.773"
                        aria-hidden="true"
                    >
                        <path
                            d="M15.769 0h.162c.13 1.606-.483 2.806-1.228 3.675-.731.863-1.732 1.7-3.351 1.573-.108-1.583.506-2.694 1.25-3.561C13.292.879 14.557.16 15.769 0zm4.901 16.716v.045c-.455 1.378-1.104 2.559-1.896 3.655-.723.995-1.609 2.334-3.191 2.334-1.367 0-2.275-.879-3.676-.903-1.482-.024-2.297.735-3.652.926h-.462c-.995-.144-1.798-.932-2.383-1.642-1.725-2.098-3.058-4.808-3.306-8.276v-1.019c.105-2.482 1.311-4.5 2.914-5.478.846-.52 2.009-.963 3.304-.765.555.086 1.122.276 1.619.464.471.181 1.06.502 1.618.485.378-.011.754-.208 1.135-.347 1.116-.403 2.21-.865 3.652-.648 1.733.262 2.963 1.032 3.723 2.22-1.466.933-2.625 2.339-2.427 4.74.176 2.181 1.444 3.457 3.028 4.209z"
                        ></path>
                    </svg>
                    <div class="store-badge-copy min-w-0 text-left">
                        <p class="store-badge-overline text-left text-[10px] leading-none text-white font-medium">
                            {localizedUi.appStoreOverline}
                        </p>
                        <span class="store-badge-title">App Store</span>
                    </div>
                </a>
                <a
                    class="store-badge inline-flex items-center rounded-lg border border-white/10 bg-[#161616] px-4 py-2 text-xl tracking-wider text-white transition hover:border-primary/40 hover:bg-[#1d1d1d] focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                    href={androidAppHref}
                    data-app-store="android"
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`Android - ${localizedUi.playStoreOverline} Google Play`}
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="store-badge-icon mr-2 inline h-9 w-9 shrink-0"
                        viewBox="0 0 64 64"
                        aria-hidden="true"
                    >
                        <path fill="#57cef3" d="M7 3v58l33-29z"></path>
                        <path fill="#fff200" d="m36 32 8-10 15 10-15 10z"></path>
                        <path fill="#48ff48" d="M36 32 7 3h4l34 20z"></path>
                        <path fill="#ff6c58" d="M36 32 7 61h4l34-20z"></path>
                        <path
                            fill="#f33"
                            d="M9.1 64c-1.9 0-3.6-1-4.5-2.6L8 58.2v.7c0 .3.1.6.3.8L24 44c7.4 0 14.1-1.2 18.3-3.1l5.8-3.4v4.6L11.7 63.3c-.7.5-1.6.7-2.6.7z"
                        ></path>
                        <path
                            fill="#0779e4"
                            d="M9.1 4C8.5 4 8 4.5 8 5.1V36c0 4.4 7.2 8 16 8L5.5 62.5c-.9-.9-1.5-2.2-1.5-3.6V5.1C4 2.3 6.3 0 9.1 0z"
                        ></path>
                        <path
                            fill="#314a52"
                            d="M8.3 4.3c.2-.2.5-.3.8-.3.2 0 .4.1.6.2l45.5 26.6c.5.2.8.7.8 1.2s-.3 1-.7 1.3l-11.4 6.6 2.9 2.9 10.4-6.1c1.7-1 2.7-2.8 2.7-4.7s-1-3.8-2.7-4.7L11.7.7C11 .2 10.1 0 9.1 0 7.7 0 6.4.6 5.5 1.5z"
                        ></path>
                    </svg>
                    <div class="store-badge-copy min-w-0 text-left">
                        <p class="store-badge-overline text-left text-[10px] leading-none text-white font-medium">
                            {localizedUi.playStoreOverline}
                        </p>
                        <span class="store-badge-title">Google Play</span>
                    </div>
                </a>
            </div>
            {isAd ? (
                <div class="space-y-3 text-center sm:text-left">
                    <p class="text-sm font-semibold text-white/70">{t.adHero.reassurance}</p>
                    <a
                        class="inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-on-surface-variant transition hover:text-white sm:justify-start"
                        href={googlePlayUrl}
                        target="_blank"
                        rel="noreferrer"
                    >
                        <span class="tracking-widest text-yellow-400" aria-label={`${heroReview.rating}/5`}>★★★★★</span>
                        <span class="italic text-white/80">“{heroReview.body}”</span>
                        <span>— {t.adHero.reviewSource}</span>
                    </a>
                </div>
            ) : (
                <div class="flex flex-wrap justify-center gap-4 sm:justify-start">
                    <a
                        class="inline-flex items-center rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/30 hover:bg-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500"
                        href={docsHref}
                    >
                        <span>{localizedUi.docsCta}</span>
                        <span class="ml-2 text-base" aria-hidden="true">→</span>
                    </a>
                </div>
            )}
        </div>
        <div class:list={["relative mt-10 lg:col-span-5 lg:mt-0", isAd && "hidden lg:block"]}>
            <div class="relative flex min-h-[560px] w-full items-center justify-center">
                <div class="absolute inset-x-[14%] top-[7%] h-[72%] rounded-full bg-primary/10 blur-3xl"></div>
                <div class="phone-shell relative z-10 w-[76%] max-w-[340px]">
                    <div class="screen-shadow overflow-hidden rounded-[2.8rem] border-[7px] border-[#1C2127] bg-[#0C1014] p-2">
                        <div class="relative aspect-[9/19] overflow-hidden rounded-[2.15rem] bg-[radial-gradient(circle_at_top,#314f8b_0%,#16233f_36%,#0d1320_72%,#091019_100%)]">
                            <div class="absolute left-1/2 top-3 h-7 w-[42%] -translate-x-1/2 rounded-full bg-black/80"></div>
                            <div class="absolute inset-0 bg-[linear-gradient(145deg,rgba(255,255,255,0.18),transparent_28%,transparent_70%,rgba(255,255,255,0.08))]"></div>
                            <div class="relative flex h-full flex-col px-5 pb-6 pt-12">
                                <div class="text-center text-white/80">
                                    <p class="text-sm font-semibold">{localizedUi.lockDate}</p>
                                    <p class="mt-2 text-7xl font-black tracking-tighter text-white/85">
                                        9:41
                                    </p>
                                </div>

                                <div class="notification-stack mt-10">
                                    {heroNotifications.map((notification) => (
                                        <div class:list={["notification-card rounded-[1.2rem] border p-2 backdrop-blur-xl md:rounded-[1.45rem] md:p-2.5", notification.stackClass]}>
                                            <div class="flex items-start gap-2 md:gap-2.5">
                                                <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#0C1014] ring-1 ring-white/10 md:h-7 md:w-7">
                                                    <img
                                                        src="/favicon-d.svg"
                                                        alt=""
                                                        class="h-3.5 w-3.5 object-contain md:h-4 md:w-4"
                                                    />
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center justify-between gap-2">
                                                        <p class="truncate text-[10px] font-semibold text-white/78 md:text-[11px]">
                                                            Vallax · <span class="text-white/55">{notification.platform}</span>
                                                        </p>
                                                        <p class="shrink-0 text-[9px] text-white/50 md:text-[10px]">
                                                            {notification.time}
                                                        </p>
                                                    </div>
                                                    <div class="mt-0.5 flex items-start gap-2 md:mt-1 md:gap-2.5">
                                                        <div class="min-w-0 flex-1">
                                                            <p class="truncate text-[12px] font-semibold leading-4 text-white md:text-[13px] md:leading-4.5">
                                                                {notification.title}
                                                            </p>
                                                            <p class="flex whitespace-nowrap text-[11px] font-medium leading-3.5 text-white/74 md:mt-0.5 md:text-[12px] md:leading-4">
                                                                {notification.listing && (
                                                                    <span class="hidden min-w-0 truncate md:inline">{notification.listing}&nbsp;·&nbsp;</span>
                                                                )}
                                                                <span class="shrink-0">{notification.price} €</span>
                                                            </p>
                                                        </div>
                                                        <div class="h-9 w-9 shrink-0 overflow-hidden rounded-[0.7rem] md:h-11 md:w-11 md:rounded-[0.85rem]">
                                                            <img
                                                                src={notification.image.src}
                                                                alt={`${notification.alt} en una notificacion de Vallax`}
                                                                class="h-full w-full object-cover"
                                                            />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script is:inline>
        (() => {
            const phone = document.querySelector(".phone-shell");
            if (!phone || !("IntersectionObserver" in window)) {
                return;
            }

            phone.classList.add("is-waiting");
            const observer = new IntersectionObserver(([entry]) => {
                if (entry.isIntersecting) {
                    phone.classList.remove("is-waiting");
                    observer.disconnect();
                }
            }, { threshold: 0.5 });
            observer.observe(phone);
        })();
    </script>
</section>

<style>
    .phone-shell {
        animation: phone-buzz 5000ms linear 1 forwards;
        animation-delay: 600ms;
        transform-origin: center center;
        will-change: transform;
    }

    /* The hero script adds .is-waiting until the phone scrolls into view, so the
       buzz plays where people see it (on mobile it sits below the CTA). */
    .phone-shell.is-waiting,
    .phone-shell.is-waiting .notification-card {
        animation-play-state: paused;
    }

    @media (prefers-reduced-motion: reduce) {
        .phone-shell,
        .notification-card {
            animation: none;
        }

        .notification-card {
            opacity: 1;
        }

        .notification-card-first {
            transform: translateY(calc(var(--notification-step) + var(--notification-step)));
        }

        .notification-card-second {
            transform: translateY(var(--notification-step));
        }
    }

    .hero-ticker-item {
        opacity: 0;
        transform: translateY(8px);
        transition:
            opacity 600ms ease,
            transform 600ms ease;
    }

    .hero-ticker-item.is-active {
        opacity: 1;
        transform: translateY(0);
    }

    .hero-ticker-item.is-leaving {
        opacity: 0;
        transform: translateY(-8px);
    }

    .notification-stack {
        --notification-step: 94px;
        position: relative;
        height: 300px;
    }

    .notification-card {
        position: absolute;
        inset-inline: 0;
        top: 0;
        opacity: 0;
        transform: translateY(0);
        will-change: transform, opacity;
    }

    .notification-card-first {
        animation: ios-notification-first 5000ms cubic-bezier(0.2, 0.9, 0.2, 1)
            forwards;
        animation-delay: 600ms;
    }

    .notification-card-second {
        animation: ios-notification-second 5000ms cubic-bezier(0.2, 0.9, 0.2, 1)
            forwards;
        animation-delay: 600ms;
    }

    .notification-card-third {
        animation: ios-notification-third 5000ms cubic-bezier(0.2, 0.9, 0.2, 1)
            forwards;
        animation-delay: 600ms;
    }

    @keyframes ios-notification-first {
        0% {
            opacity: 0;
            transform: translateY(-14px) scale(0.96);
        }

        12%,
        30% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        40%,
        70% {
            opacity: 1;
            transform: translateY(var(--notification-step)) scale(1);
        }

        80%,
        100% {
            opacity: 1;
            transform: translateY(calc(var(--notification-step) + var(--notification-step))) scale(1);
        }
    }

    @keyframes ios-notification-second {
        0%,
        40% {
            opacity: 0;
            transform: translateY(-14px) scale(0.96);
        }

        52%,
        70% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        80%,
        100% {
            opacity: 1;
            transform: translateY(var(--notification-step)) scale(1);
        }
    }

    @keyframes ios-notification-third {
        0%,
        80% {
            opacity: 0;
            transform: translateY(-14px) scale(0.96);
        }

        92%,
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @keyframes phone-buzz {
        0.0%,
        3.5%,
        39.6%,
        43.1%,
        79.6%,
        83.1%,
        100% {
            transform: translate3d(0, 0, 0) rotate(0deg);
        }

        0.5% {
