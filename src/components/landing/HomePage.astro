    isAd && (
        <Fragment>
            <div
                id="sticky-store-cta"
                class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-white/10 bg-background/90 px-4 pb-[calc(env(safe-area-inset-bottom)+0.75rem)] pt-3 opacity-0 backdrop-blur-xl transition duration-300 sm:hidden"
                aria-hidden="true"
            >
                <a
                    class="mobile-store-cta flex w-full items-center justify-center gap-2 rounded-2xl bg-primary px-6 py-3.5 text-base font-extrabold text-on-primary active:scale-[0.98]"
                    href={androidAppHref}
                    data-app-store="android"
                    target="_blank"
                    rel="noreferrer"
                    tabindex="-1"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">download</span>
                    <span>{t.adHero.primaryCta}</span>
                </a>
            </div>

            <script is:inline define:vars={{ iosAppHref }}>
                (() => {
                    const ua = navigator.userAgent;
                    const isIos =
                        /iPhone|iPad|iPod/i.test(ua) ||
                        (/Macintosh/i.test(ua) && navigator.maxTouchPoints > 1);

                    if (isIos) {
                        document.querySelectorAll(".mobile-store-cta").forEach((link) => {
                            link.href = iosAppHref;
                            link.dataset.appStore = "ios";
                        });
                    }

                    const heroCta = document.getElementById("hero-mobile-cta");
                    const stickyCta = document.getElementById("sticky-store-cta");
                    if (!heroCta || !stickyCta || !("IntersectionObserver" in window)) {
                        return;
                    }

                    new IntersectionObserver(([entry]) => {
                        const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
                        stickyCta.classList.toggle("translate-y-full", !show);
                        stickyCta.classList.toggle("opacity-0", !show);
                        stickyCta.classList.toggle("pointer-events-none", !show);
                        stickyCta.setAttribute("aria-hidden", String(!show));
                        stickyCta.querySelector("a")?.setAttribute("tabindex", show ? "0" : "-1");
                    }).observe(heroCta);
                })();
            </script>
        </Fragment>
    )
}
