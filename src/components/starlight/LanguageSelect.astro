---
import config from 'virtual:starlight/user-config';
import Select from '@astrojs/starlight/components/Select.astro';
import { locales as siteLocales } from '../../i18n';

const configuredLocales = config.locales ?? {};
const defaultLocale = siteLocales[0];

function normalizeLocaleCode(code: string): string {
	return code === 'root' ? defaultLocale : code;
}

function getCurrentLocale(pathname: string): string {
	const firstSegment = pathname.split('/').filter(Boolean)[0];
	return firstSegment && siteLocales.includes(firstSegment as typeof siteLocales[number])
		? firstSegment
		: defaultLocale;
}
const currentLocale = Astro.locals.starlightRoute.locale || getCurrentLocale(Astro.url.pathname);
---

{
	config.isMultilingual && (
		<starlight-lang-select data-locales={JSON.stringify(siteLocales)}>
			<Select
				icon="translate"
				label={Astro.locals.t('languageSelect.accessibleLabel')}
				options={Object.entries(configuredLocales).map(([code, locale]) => ({
					value: normalizeLocaleCode(code),
					selected: normalizeLocaleCode(code) === currentLocale,
					label: locale!.label,
				}))}
				width="7em"
			/>
		</starlight-lang-select>
	)
}

<script>
	class StarlightLanguageSelect extends HTMLElement {
		constructor() {
			super();
			const select = this.querySelector('select');
			if (!select) return;
			const supportedLocales = JSON.parse(this.dataset.locales ?? '[]') as string[];

			const syncSelectedOption = () => {
				const currentLocale = window.location.pathname.split('/').filter(Boolean)[0];
				const exactMatch = Array.from(select.options).findIndex(
					(option) => option.value === currentLocale,
				);
				select.selectedIndex = exactMatch >= 0 ? exactMatch : 0;
			};

			syncSelectedOption();

			select.addEventListener('change', (e) => {
				if (e.currentTarget instanceof HTMLSelectElement) {
					const locale = e.currentTarget.value;
					const segments = window.location.pathname.split('/').filter(Boolean);
					while (segments[0] && supportedLocales.includes(segments[0])) {
						segments.shift();
					}
					const suffix = segments.length > 0 ? `/${segments.join('/')}/` : '/';
					window.location.assign(`/${locale}${suffix}`);
				}
			});

			window.addEventListener('pageshow', () => {
				syncSelectedOption();
			});
		}
	}

	if (!customElements.get('starlight-lang-select')) {
		customElements.define('starlight-lang-select', StarlightLanguageSelect);
	}
</script>
