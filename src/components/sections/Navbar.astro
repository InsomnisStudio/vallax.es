---
import Logo from "../../images/logo_vertical.svg";
import {
    localeLabels,
    locales,
    type Translation,
    type Locale,
} from "../../i18n";

interface Props {
    t: Translation["navbar"];
    lang: Locale;
}

const { t, lang } = Astro.props as Props;

const localePrefix = `/${lang}`;
const homeHref = `${localePrefix}/`;

const links = [
    { href: `${homeHref}#getting-started`, label: t.links.gettingStarted },
    { href: `${homeHref}#features`, label: t.links.features },
    { href: `${homeHref}#pricing`, label: t.links.pricing },
    { href: `${homeHref}#community`, label: t.links.community },
    { href: `${homeHref}#faq`, label: t.links.faq },
    { href: `${localePrefix}/guides/`, label: t.links.guides },
];

const visibleLinks = links.filter((link) => link.href !== "#pricing");
const languageLinks = locales.map((locale) => ({
    href: `/${locale}/`,
    hreflang: locale,
    label: localeLabels[locale],
    isCurrent: locale === lang,
}));
const currentLanguage = localeLabels[lang];
---

<nav class="fixed top-0 left-0 z-50 w-full bg-black/50 backdrop-blur-xl">
    <div
        class="mx-auto w-full px-4 lg:px-6 xl:max-w-7xl flex h-full justify-between py-3"
    >
        <a href={homeHref} class="flex items-center gap-3 w-51">
            <Logo class="w-auto h-9" aria-label="vallax logo" />
        </a>

        <div
            class="hidden lg:flex items-center gap-6 text-xs uppercase tracking-[0.3em] text-white/60"
        >
            {
                visibleLinks.map((link) => (
                    <a href={link.href} class="hover:text-white">
                        {link.label}
                    </a>
                ))
            }
        </div>

        <div class="hidden lg:block w-51">
            <div class="flex items-center">
                <div class="relative mr-5 mx-6" id="language-menu">
                    <button
                        id="language-menu-toggle"
                        type="button"
                        class="inline-flex items-center gap-2 rounded-full border border-white/20 px-3 py-1.5 text-xs text-white/80 transition-colors hover:border-white/40 hover:text-white"
                        aria-label={t.languageSwitcher.label}
                        aria-expanded="false"
                        aria-controls="language-menu-panel"
                    >
                        <span>{currentLanguage}</span>
                        <span class="text-[10px] text-white/60">
                            {lang.toUpperCase()}
                        </span>
                        <svg
                            id="language-menu-chevron"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            class="h-3.5 w-3.5 text-white/60 transition-transform duration-150"
                            aria-hidden="true"
                        >
                            <path
                                d="m6 9 6 6 6-6"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.8"
                                stroke-linecap="round"
                                stroke-linejoin="round"></path>
                        </svg>
                    </button>
                    <div
                        id="language-menu-panel"
                        class="absolute right-0 mt-2 hidden min-w-44 rounded-xl border border-white/15 bg-black/95 p-2"
                    >
                        {
                            languageLinks.map((localeLink) => (
                                <a
                                    href={localeLink.href}
                                    hreflang={localeLink.hreflang}
                                    class={`language-option flex items-center justify-between rounded-lg px-3 py-2 text-xs transition-colors ${
                                        localeLink.isCurrent
                                            ? "bg-white/10 text-white"
                                            : "text-white/70 hover:bg-white/10 hover:text-white"
                                    }`}
                                >
                                    <span>{localeLink.label}</span>
                                    <span class="text-[10px]">
                                        {localeLink.hreflang.toUpperCase()}
                                    </span>
                                </a>
                            ))
                        }
                    </div>
                </div>

                <a
                    href="#"
                    class="block min-w-28 py-2 text-center text-sm font-bold text-white/60 hover:text-primary"
                    onclick="return gtag_report_conversion('https://t.me/vallaxbot')"
                >
                    {t.primaryCta}
                </a>
            </div>
        </div>

        <button
            id="mobile-menu-toggle"
            aria-label="Toggle menu"
            class="flex h-10 w-10 items-center justify-center border border-white/20 bg-black/50 lg:hidden"
        >
            <span class="sr-only">Toggle navigation</span>
            <div class="space-y-[6px]">
                <span
                    class="block h-0.5 w-6 bg-white transition-transform duration-200 rounded-full"
                ></span>
                <span
                    class="block h-0.5 w-6 bg-white transition-opacity duration-200 rounded-full"
                ></span>
                <span
                    class="block h-0.5 w-6 bg-white transition-transform duration-200 rounded-full"
                ></span>
            </div>
        </button>
    </div>

    <div id="mobile-menu-overlay" class="fixed inset-0 z-40 hidden bg-black/80">
    </div>

    <div
        id="mobile-menu"
        class="fixed inset-x-0 top-[72px] z-50 hidden bg-black/95 text-xs uppercase tracking-[0.3em] text-white/70"
    >
        <nav class="flex flex-col">
            {
                visibleLinks.map((link, index) => (
                    <a
                        onclick="window.closeMobileMenu()"
                        href={link.href}
                        class={`px-[6%] py-4 transition-colors hover:text-white ${
                            index === 0 ? "" : "border-t"
                        } border-white/10`}
                    >
                        {link.label}
                    </a>
                ))
            }

            <a
                onclick="window.closeMobileMenu(); trackClick('nav-mobile-primary'); return gtag_report_conversion('https://t.me/vallaxbot?start=nav_cta')"
                href="https://t.me/vallaxbot?start=nav_cta"
                target="_blank"
                class="px-[6%] py-4 border-t border-white/10 text-primary transition-colors hover:text-primary/80"
            >
                {t.primaryCta}
            </a>
            <div class="border-t border-white/10 px-[6%] py-4">
                <p
                    class="mb-3 text-[10px] uppercase tracking-[0.2em] text-white/50"
                >
                    {t.languageSwitcher.label}
                </p>
                <div class="grid grid-cols-2 gap-2">
                    {
                        languageLinks.map((localeLink) => (
                            <a
                                onclick="window.closeMobileMenu()"
                                href={localeLink.href}
                                hreflang={localeLink.hreflang}
                                class={`rounded-lg border px-3 py-2 text-center text-[11px] tracking-[0.2em] transition-colors ${
                                    localeLink.isCurrent
                                        ? "border-primary/70 bg-primary/10 text-primary"
                                        : "border-white/15 text-white/70 hover:border-white/40 hover:text-white"
                                }`}
                            >
                                {localeLink.hreflang.toUpperCase()}
                            </a>
                        ))
                    }
                </div>
            </div>
        </nav>
    </div>
</nav>

<style>
    nav a.active {
        color: white;
    }
</style>

<script>
    const sections = document.querySelectorAll("section");

    const navLinks = Array.from(document.querySelectorAll("nav a"));

    const options = {
        root: null,
        rootMargin: "-50% 0px -50% 0px",
        threshold: 0,
    };

    const callback = (entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const sectionId = entry.target.id;

                navLinks.forEach((link) => {
                    link.classList.remove("active");
                });

                const activeLink = navLinks.find((link) => {
                    const href = link.getAttribute("href") || "";
                    return href.endsWith(`#${sectionId}`);
                });
                if (activeLink) {
                    activeLink.classList.add("active");
                }
            }
        });
    };

    const observer = new IntersectionObserver(callback, options);

    sections.forEach((section) => {
        observer.observe(section);
    });

    const languageMenu = document.getElementById("language-menu");
    const languageToggle = document.getElementById("language-menu-toggle");
    const languagePanel = document.getElementById("language-menu-panel");
    const languageChevron = document.getElementById("language-menu-chevron");
    const languageOptions = Array.from(
        document.querySelectorAll(".language-option"),
    );

    if (languageMenu && languageToggle && languagePanel && languageChevron) {
        const openLanguageMenu = () => {
            languagePanel.classList.remove("hidden");
            languageToggle.setAttribute("aria-expanded", "true");
            languageChevron.classList.add("rotate-180");
        };

        const closeLanguageMenu = () => {
            languagePanel.classList.add("hidden");
            languageToggle.setAttribute("aria-expanded", "false");
            languageChevron.classList.remove("rotate-180");
        };

        languageToggle.addEventListener("click", (event) => {
            event.stopPropagation();
            if (languagePanel.classList.contains("hidden")) {
                openLanguageMenu();
            } else {
                closeLanguageMenu();
            }
        });

        languageOptions.forEach((option) => {
            option.addEventListener("click", () => {
                closeLanguageMenu();
            });
        });

        document.addEventListener("click", (event) => {
            if (!languageMenu.contains(event.target)) {
                closeLanguageMenu();
            }
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
                closeLanguageMenu();
            }
        });
    }
</script>
