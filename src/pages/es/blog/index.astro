---
import { getCollection } from "astro:content";
import LandingLayout from "../../../layouts/LandingLayout.astro";
import { translations } from "../../../i18n";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const t = translations.es;
const seo = {
    title: "Blog de segunda mano y alertas | Vallax App",
    description:
        "Guías prácticas para comprar, coleccionar y revender productos de segunda mano sin perder los anuncios que merecen la pena.",
};
const formatDate = (date: Date) =>
    new Intl.DateTimeFormat("es-ES", {
        day: "numeric",
        month: "long",
        year: "numeric",
        timeZone: "Europe/Madrid",
    }).format(date);
const postHref = (id: string) => `/es/blog/${id.replace(/\.md$/, "")}/`;
---

<LandingLayout
    lang="es"
    seo={seo}
    navbar={t.navbar}
    footer={t.footer}
    onlyCurrentLocale
>
    <section class="blog-index-hero relative overflow-hidden px-6 pb-20 pt-36 text-white md:px-16 md:pb-28 md:pt-44">
        <div class="blog-grid-glow" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl">
            <p class="text-xs font-black uppercase tracking-[0.24em] text-primary">Cuaderno de campo</p>
            <h1 class="mt-7 max-w-5xl text-5xl font-black leading-[0.96] tracking-[-0.055em] md:text-7xl lg:text-8xl">
                Segunda mano,<br /><span class="text-primary">sin llegar tarde.</span>
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-8 text-white/65 md:text-xl">
                Precios, comprobaciones y tácticas que sirven cuando el anuncio bueno dura minutos, no días.
            </p>
        </div>
    </section>

    <section class="px-6 py-20 text-white md:px-16 md:py-28">
        <div class="mx-auto max-w-7xl">
            <div class="grid gap-x-8 gap-y-16 md:grid-cols-2">
                {posts.map((post, index) => (
                    <article class:list={["group", index === 0 && "md:col-span-2"]}>
                        <a href={postHref(post.id)} class:list={["block overflow-hidden bg-white/5", index === 0 ? "aspect-[1200/630]" : "aspect-[16/10]"]}>
                            <img
                                src={post.data.image}
                                width="1200"
                                height="630"
                                alt={post.data.imageAlt}
                                loading="lazy"
                                decoding="async"
                                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]"
                            />
                        </a>
                        <div class:list={["mt-6", index === 0 && "md:grid md:grid-cols-[1.25fr_0.75fr] md:gap-12"]}>
                            <div>
                                <p class="text-xs font-black uppercase tracking-[0.18em] text-primary">{formatDate(post.data.publishedAt)}</p>
                                <h2 class:list={["mt-3 font-black leading-tight tracking-tight", index === 0 ? "text-3xl md:text-5xl" : "text-2xl md:text-3xl"]}>
                                    <a href={postHref(post.id)} class="transition hover:text-primary">{post.data.title}</a>
                                </h2>
                            </div>
                            <p class:list={["leading-7 text-white/55", index === 0 ? "mt-5 md:mt-7" : "mt-4"]}>{post.data.excerpt}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</LandingLayout>
