---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../../i18n";
import { solutionPages, seoUi } from "../../../data/seo-pages";

export function getStaticPaths() {
    return locales.map((locale) => ({ params: { lang: locale } }));
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const ui = seoUi[locale];

const pageSeo = {
    title: `${ui.solutionHubTitle} | App Vallax`,
    description: ui.solutionHubDescription,
};
---

<LandingLayout lang={locale} seo={pageSeo} navbar={t.navbar} footer={t.footer}>
    <section class="seo-directory relative overflow-hidden px-6 pb-24 pt-36 text-white md:px-16 md:pb-36 md:pt-44">
        <div class="seo-orbit seo-orbit-two" aria-hidden="true"></div>
        <div class="mx-auto max-w-6xl">
            <header class="relative mb-16 max-w-4xl md:mb-24">
                <p class="text-xs font-black uppercase tracking-[0.25em] text-secondary">
                    Vallax / {ui.solutionGroupTitle}
                </p>
                <h1 class="mt-6 text-5xl font-black leading-none tracking-[-0.05em] md:text-7xl">
                    {ui.solutionHubTitle}
                </h1>
                <p class="mt-7 max-w-2xl text-lg leading-8 text-white/60">
                    {ui.solutionHubDescription}
                </p>
            </header>

            <div class="relative border-t border-white/15">
                {
                    solutionPages.map((page, index) => {
                        const item = page.locale[locale];
                        return (
                            <a
                                href={`/${locale}/solutions/${page.slug}/`}
                                class="group grid gap-3 border-b border-white/15 py-8 transition md:grid-cols-[5rem_1fr_auto] md:items-center md:py-11"
                            >
                                <span class="text-xs font-black text-white/25">0{index + 1}</span>
                                <h2 class="text-2xl font-black text-white transition group-hover:translate-x-2 group-hover:text-secondary md:text-4xl">
                                    {item.title}
                                </h2>
                                <span class="material-symbols-outlined text-white/30 transition group-hover:translate-x-2 group-hover:text-secondary">
                                    arrow_forward
                                </span>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>
</LandingLayout>
