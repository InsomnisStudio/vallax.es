---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../../i18n";
import { platformPages, solutionPages, seoUi } from "../../../data/seo-pages";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return locales.flatMap((locale) =>
        solutionPages.map((page) => ({
            params: { lang: locale, slug: page.slug },
        })),
    );
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const ui = seoUi[locale];
const slug = Astro.params.slug ?? "";
const currentPage = solutionPages.find((page) => page.slug === slug);

if (!currentPage) {
    throw new Error(`Unknown solution page: ${slug}`);
}

const copy = currentPage.locale[locale];
const relatedPages = solutionPages.filter((page) => page.slug !== slug).slice(0, 2);
const homeHref = `/${locale}/`;
const pageSeo = {
    title: copy.title,
    description: copy.description,
};
const relevantPlatformSlug: Record<string, string> = {
    "for-resellers": "wallapop-alerts",
    "for-collectors": "todocoleccion-alerts",
    "for-bargain-hunters": "vinted-alerts",
};
const relevantPlatform = platformPages.find(
    (page) => page.slug === relevantPlatformSlug[currentPage.slug],
);
const detailUi: Record<Locale, { marker: string; promise: string; next: string }> = {
    es: { marker: "Diseñado para actuar antes", promise: "Menos tiempo buscando. Más oportunidades reales.", next: "Tu siguiente búsqueda puede empezar aquí" },
    en: { marker: "Designed to act first", promise: "Less time searching. More real opportunities.", next: "Your next search can start here" },
    fr: { marker: "Conçu pour agir avant", promise: "Moins de temps à chercher. Plus de vraies opportunités.", next: "Votre prochaine recherche commence ici" },
    it: { marker: "Pensato per agire prima", promise: "Meno tempo a cercare. Più opportunità reali.", next: "La tua prossima ricerca può iniziare qui" },
    pl: { marker: "Stworzone, by działać szybciej", promise: "Mniej szukania. Więcej prawdziwych okazji.", next: "Twoje następne wyszukiwanie zaczyna się tutaj" },
};
const detail = detailUi[locale];
const blogSlugsBySolution: Record<string, string[]> = {
    "for-resellers": ["ps5-barata-segunda-mano", "wallapop-vs-vinted-vs-milanuncios"],
    "for-collectors": ["wallapop-vs-vinted-vs-milanuncios"],
    "for-bargain-hunters": ["ps5-barata-segunda-mano", "wallapop-vs-vinted-vs-milanuncios"],
};
const relatedPosts = locale === "es"
    ? (await getCollection("blog")).filter((post) =>
          blogSlugsBySolution[currentPage.slug]?.includes(post.id.replace(/\.md$/, "")),
      )
    : [];
---

<LandingLayout lang={locale} seo={pageSeo} navbar={t.navbar} footer={t.footer}>
    <section class="seo-solution-hero relative overflow-hidden px-6 pb-24 pt-36 text-white md:px-16 md:pb-36 md:pt-44">
        <div class="seo-solution-grid" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-7xl">
            <a href={`/${locale}/solutions/`} class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.24em] text-secondary">
                {ui.solutionGroupTitle}<span class="h-px w-10 bg-secondary"></span>
            </a>
            <div class="mt-10 grid gap-12 lg:grid-cols-[1.35fr_0.65fr] lg:items-end">
                <h1 class="max-w-5xl text-5xl font-black leading-[0.97] tracking-[-0.055em] md:text-7xl lg:text-8xl">{copy.title}</h1>
                <div class="border-l border-primary/40 pl-6 md:pl-8">
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-primary">{detail.marker}</p>
                    <p class="mt-5 text-lg leading-8 text-white/65">{copy.description}</p>
                </div>
            </div>
        </div>
    </section>

    <section class="border-y border-white/5 bg-black/25 px-6 py-24 text-white md:px-16 md:py-32">
        <div class="mx-auto max-w-7xl">
            <div class="grid gap-14 lg:grid-cols-2 lg:gap-24">
                <div>
                    <p class="max-w-xl text-2xl font-semibold leading-10 text-white/75 md:text-3xl md:leading-[1.5]">{copy.intro}</p>
                    <a href={`${homeHref}#download-app`} class="mt-10 inline-flex items-center gap-3 bg-primary px-7 py-4 font-black text-on-primary transition hover:bg-secondary">
                        {copy.cta}<span class="material-symbols-outlined">arrow_outward</span>
                    </a>
                </div>
                <div>
                    <h2 class="text-3xl font-black tracking-tight md:text-5xl">{detail.promise}</h2>
                    <ul class="mt-10">
                        {copy.bullets.map((bullet, index) => (
                            <li class="grid grid-cols-[2.5rem_1fr] gap-4 border-t border-white/12 py-6 last:border-b md:py-8">
                                <span class="font-black text-secondary">{index + 1}</span>
                                <p class="text-lg font-bold leading-7 text-white">{bullet}</p>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section class="px-6 py-24 text-white md:px-16 md:py-32">
        <div class="mx-auto max-w-7xl">
            <p class="text-xs font-black uppercase tracking-[0.24em] text-primary">{detail.next}</p>
            {relevantPlatform && (
                <a href={`/${locale}/platforms/${relevantPlatform.slug}/`} class="group mt-7 flex items-end justify-between gap-8 border-y border-white/12 py-10 md:py-14">
                    <div>
                        <p class="text-sm text-white/40">{ui.platformGroupTitle}</p>
                        <h2 class="mt-3 max-w-4xl text-3xl font-black leading-tight tracking-tight transition group-hover:text-primary md:text-6xl">{relevantPlatform.locale[locale].title}</h2>
                    </div>
                    <span class="material-symbols-outlined mb-2 text-4xl text-primary transition group-hover:translate-x-2">arrow_forward</span>
                </a>
            )}

            {relatedPosts.length > 0 && (
                <div class="mt-24 grid gap-8 md:grid-cols-[0.55fr_1.45fr]">
                    <h2 class="text-2xl font-black">Artículos relacionados</h2>
                    <div class="border-t border-white/12">
                        {relatedPosts.map((post) => (
                            <a href={`/es/blog/${post.id.replace(/\.md$/, "")}/`} class="group flex items-center justify-between gap-8 border-b border-white/12 py-7">
                                <p class="text-lg font-bold text-white/75 transition group-hover:text-primary md:text-xl">{post.data.title}</p>
                                <span class="material-symbols-outlined text-white/30 transition group-hover:text-primary">north_east</span>
                            </a>
                        ))}
                    </div>
                </div>
            )}

            <div class="mt-24 grid gap-8 md:grid-cols-[0.55fr_1.45fr]">
                <h2 class="text-2xl font-black">{ui.relatedTitle}</h2>
                <div class="border-t border-white/12">
                    {relatedPages.map((page) => (
                        <a href={`/${locale}/solutions/${page.slug}/`} class="group flex items-center justify-between gap-8 border-b border-white/12 py-7">
                            <p class="text-lg font-bold text-white/75 transition group-hover:text-primary md:text-xl">{page.locale[locale].title}</p>
                            <span class="material-symbols-outlined text-white/30 transition group-hover:text-primary">north_east</span>
                        </a>
                    ))}
                    <a href={`/${locale}/platforms/`} class="mt-7 inline-flex items-center gap-2 text-sm font-black text-primary">{ui.openGroup} {ui.platformGroupTitle.toLowerCase()} <span class="material-symbols-outlined text-lg">arrow_forward</span></a>
                </div>
            </div>
        </div>
    </section>
</LandingLayout>
