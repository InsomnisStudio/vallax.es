---
import LandingLayout from "../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../i18n";
import { proposals, proposalsUi } from "../../data/proposals";

export function getStaticPaths() {
    return locales.map((locale) => ({ params: { lang: locale } }));
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const ui = proposalsUi[locale];
const accepted = proposals.filter((proposal) => proposal.status === "accepted");
const completed = proposals.filter((proposal) => proposal.status === "completed");
const orderedProposals = [...accepted, ...completed];
const allLabels: Record<Locale, string> = {
    es: "Todas", en: "All", fr: "Toutes", it: "Tutte", pl: "Wszystkie",
};
const moreLabels: Record<Locale, string> = {
    es: "Ver más propuestas", en: "Show more ideas", fr: "Voir plus de propositions",
    it: "Mostra altre proposte", pl: "Pokaz wiecej pomyslow",
};
const originLabels: Record<Locale, { team: string; community: string }> = {
    es: { team: "Equipo Vallax", community: "Comunidad" },
    en: { team: "Vallax team", community: "Community" },
    fr: { team: "Équipe Vallax", community: "Communauté" },
    it: { team: "Team Vallax", community: "Community" },
    pl: { team: "Zespol Vallax", community: "Spolecznosc" },
};
const sendStateLabels: Record<Locale, { idle: string; sending: string; success: string; error: string }> = {
    es: { idle: "Enviar propuesta", sending: "Enviando...", success: "Propuesta enviada correctamente. Gracias por compartirla.", error: "No se ha podido enviar. Inténtalo de nuevo en unos minutos." },
    en: { idle: "Send idea", sending: "Sending...", success: "Your idea was sent successfully. Thank you for sharing it.", error: "It could not be sent. Please try again in a few minutes." },
    fr: { idle: "Envoyer la proposition", sending: "Envoi...", success: "Votre proposition a bien été envoyée. Merci de l'avoir partagée.", error: "L'envoi a échoué. Veuillez réessayer dans quelques minutes." },
    it: { idle: "Invia proposta", sending: "Invio...", success: "La proposta è stata inviata correttamente. Grazie per averla condivisa.", error: "Invio non riuscito. Riprova tra qualche minuto." },
    pl: { idle: "Wyslij pomysl", sending: "Wysylanie...", success: "Pomysl zostal wyslany. Dziekujemy za jego udostepnienie.", error: "Nie udalo sie wyslac pomyslu. Sprobuj ponownie za kilka minut." },
};
---

<LandingLayout
    lang={locale}
    seo={{ title: ui.seoTitle, description: ui.seoDescription }}
    navbar={t.navbar}
    footer={t.footer}
>
    <section class="proposals-hero relative overflow-hidden px-6 pb-20 pt-36 text-white md:px-16 md:pb-24 md:pt-40">
        <div class="proposal-orb proposal-orb-one" aria-hidden="true"></div>
        <div class="proposal-orb proposal-orb-two" aria-hidden="true"></div>
        <div class="relative mx-auto max-w-6xl">
            <header class="mx-auto max-w-3xl text-center">
                <p class="text-xs font-bold uppercase tracking-[0.28em] text-primary">{ui.eyebrow}</p>
                <h1 class="mt-5 text-4xl font-extrabold tracking-[-0.04em] sm:text-5xl md:text-6xl">{ui.title}</h1>
                <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-white/65 md:text-lg">{ui.description}</p>
            </header>

            <section class="mx-auto mt-14 max-w-4xl" aria-label={ui.title}>
                <div class="mb-5 flex flex-wrap items-center gap-2" role="group" aria-label="Filter">
                    <button class="proposal-filter is-active" type="button" data-filter="all" aria-pressed="true">
                        {allLabels[locale]} <span>{orderedProposals.length}</span>
                    </button>
                    <button class="proposal-filter" type="button" data-filter="accepted" aria-pressed="false">
                        {ui.acceptedTitle} <span>{accepted.length}</span>
                    </button>
                    <button class="proposal-filter" type="button" data-filter="completed" aria-pressed="false">
                        {ui.completedTitle} <span>{completed.length}</span>
                    </button>
                </div>

                <div id="proposal-list" class="border-y border-white/10">
                    {orderedProposals.map((proposal, index) => (
                        <article
                            class="proposal-row grid gap-3 border-b border-white/[0.07] py-6 last:border-b-0 md:grid-cols-[1fr_auto] md:items-center md:gap-8"
                            data-status={proposal.status}
                            data-index={index}
                        >
                            <div>
                                <h2 class="text-lg font-bold text-white">{proposal.title[locale]}</h2>
                                <p class="mt-1.5 text-sm leading-6 text-white/50">{proposal.description[locale]}</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 md:justify-end">
                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-white/40">
                                    <span class="material-symbols-outlined text-[17px]">
                                        {proposal.origin === "community" ? "person" : "groups"}
                                    </span>
                                    {proposal.origin === "community" && proposal.author
                                        ? proposal.author
                                        : originLabels[locale][proposal.origin]}
                                </span>
                                <span class:list={[
                                    "proposal-status inline-flex w-fit items-center gap-1.5 text-xs font-bold",
                                    proposal.status === "completed" ? "text-secondary" : "text-primary",
                                ]}>
                                    <span class="material-symbols-outlined text-[18px]">
                                        {proposal.status === "completed" ? "check_circle" : "schedule"}
                                    </span>
                                    {proposal.status === "completed" ? ui.completedTitle : ui.acceptedTitle}
                                </span>
                            </div>
                        </article>
                    ))}
                </div>

                <button id="show-more-proposals" type="button" class="mx-auto mt-7 hidden items-center gap-2 text-sm font-bold text-white/60 transition hover:text-primary">
                    {moreLabels[locale]}
                    <span class="material-symbols-outlined text-[18px]">expand_more</span>
                </button>
            </section>
        </div>
    </section>

    <section class="border-t border-white/5 bg-[#090d10] px-6 py-20 text-white md:px-16 md:py-28">
        <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-20">
            <header class="lg:sticky lg:top-32">
                <p class="text-xs font-bold uppercase tracking-[0.28em] text-secondary">{ui.formEyebrow}</p>
                <h2 class="mt-4 text-3xl font-extrabold tracking-tight md:text-5xl">{ui.formTitle}</h2>
                <p class="mt-5 max-w-md leading-7 text-white/60">{ui.formDescription}</p>
                <div class="mt-8 flex items-center gap-3 text-sm text-white/45">
                    <span class="material-symbols-outlined text-[20px] text-primary">mail</span>
                    vallaxdev@gmail.com
                </div>
            </header>

            <form
                id="proposal-form"
                class="rounded-[2rem] border border-white/10 bg-white/[0.035] p-6 shadow-2xl shadow-black/20 md:p-9"
                data-idle={sendStateLabels[locale].idle}
                data-sending={sendStateLabels[locale].sending}
                data-success={sendStateLabels[locale].success}
                data-error={sendStateLabels[locale].error}
            >
                <div class="grid gap-6 sm:grid-cols-2">
                    <label class="form-field">
                        <span>{ui.nameLabel}</span>
                        <input name="name" type="text" autocomplete="name" required maxlength="80" placeholder={ui.namePlaceholder} />
                    </label>
                    <label class="form-field">
                        <span>{ui.emailLabel}</span>
                        <input name="email" type="email" autocomplete="email" required maxlength="254" placeholder={ui.emailPlaceholder} />
                    </label>
                </div>
                <label class="form-field mt-6">
                    <span>{ui.subjectLabel}</span>
                    <input name="subject" type="text" required maxlength="100" placeholder={ui.subjectPlaceholder} />
                </label>
                <label class="form-field mt-6">
                    <span>{ui.proposalLabel}</span>
                    <textarea name="proposal" required minlength="20" maxlength="3000" rows="7" placeholder={ui.proposalPlaceholder}></textarea>
                </label>
                <button id="proposal-submit" type="submit" class="mt-7 inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-primary px-6 py-4 text-sm font-extrabold text-on-primary transition hover:-translate-y-0.5 hover:bg-[#22ead5] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary disabled:cursor-wait disabled:opacity-60 sm:w-auto">
                    <span id="proposal-submit-label">{sendStateLabels[locale].idle}</span>
                    <span class="material-symbols-outlined text-[19px]">arrow_outward</span>
                </button>
                <p id="proposal-result" class="mt-5 hidden text-sm leading-6" role="status" aria-live="polite"></p>
            </form>
        </div>
    </section>
</LandingLayout>

<script>
    import { sendEmail } from "../../data/api";

    const form = document.querySelector<HTMLFormElement>("#proposal-form");
    const submitButton = document.querySelector<HTMLButtonElement>("#proposal-submit");
    const submitLabel = document.querySelector<HTMLElement>("#proposal-submit-label");
    const resultMessage = document.querySelector<HTMLElement>("#proposal-result");
    const proposalRows = Array.from(document.querySelectorAll<HTMLElement>(".proposal-row"));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".proposal-filter"));
    const showMoreButton = document.querySelector<HTMLButtonElement>("#show-more-proposals");
    const pageSize = 8;
    let activeFilter = "all";
    let visibleLimit = pageSize;

    const updateProposalList = () => {
        const matchingRows = proposalRows.filter(
            (row) => activeFilter === "all" || row.dataset.status === activeFilter,
        );

        proposalRows.forEach((row) => {
            const matchIndex = matchingRows.indexOf(row);
            row.hidden = matchIndex === -1 || matchIndex >= visibleLimit;
        });

        showMoreButton?.classList.toggle("hidden", matchingRows.length <= visibleLimit);
        showMoreButton?.classList.toggle("flex", matchingRows.length > visibleLimit);
    };

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            activeFilter = button.dataset.filter ?? "all";
            visibleLimit = pageSize;
            filterButtons.forEach((item) => {
                const isActive = item === button;
                item.classList.toggle("is-active", isActive);
                item.setAttribute("aria-pressed", String(isActive));
            });
            updateProposalList();
        });
    });

    showMoreButton?.addEventListener("click", () => {
        visibleLimit += pageSize;
        updateProposalList();
    });

    updateProposalList();

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;

        const data = new FormData(form);
        const email = String(data.get("email") ?? "").trim();
        const name = String(data.get("name") ?? "").trim();
        const title = String(data.get("subject") ?? "").trim();
        const content = String(data.get("proposal") ?? "").trim();

        submitButton?.setAttribute("disabled", "");
        if (submitLabel) submitLabel.textContent = form.dataset.sending ?? "Sending...";
        resultMessage?.classList.add("hidden");

        try {
            await sendEmail(email, name, title, content);
            form.reset();
            if (resultMessage) {
                resultMessage.textContent = form.dataset.success ?? "Sent";
                resultMessage.className = "mt-5 text-sm leading-6 text-primary";
            }
        } catch (error) {
            console.error("Unable to send proposal", error);
            if (resultMessage) {
                resultMessage.textContent = form.dataset.error ?? "Unable to send";
                resultMessage.className = "mt-5 text-sm leading-6 text-red-300";
            }
        } finally {
            submitButton?.removeAttribute("disabled");
            if (submitLabel) submitLabel.textContent = form.dataset.idle ?? "Send";
        }
    });
</script>

<style>
    .proposals-hero { background: radial-gradient(circle at 50% 0%, rgba(7, 217, 196, 0.1), transparent 35%), #0c1014; }
    .proposal-orb { position: absolute; border-radius: 999px; filter: blur(1px); opacity: 0.16; }
    .proposal-orb-one { width: 24rem; height: 24rem; top: 9rem; left: -15rem; background: #07d9c4; }
    .proposal-orb-two { width: 18rem; height: 18rem; right: -10rem; bottom: 3rem; background: #e0e938; opacity: 0.08; }
    .proposal-filter { display: inline-flex; align-items: center; gap: .5rem; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; padding: .55rem .8rem; color: rgba(255,255,255,.48); font-size: .75rem; font-weight: 700; transition: color 160ms, border-color 160ms, background 160ms; }
    .proposal-filter span { color: rgba(255,255,255,.3); font-variant-numeric: tabular-nums; }
    .proposal-filter:hover { color: rgba(255,255,255,.8); border-color: rgba(255,255,255,.2); }
    .proposal-filter.is-active { border-color: rgba(7,217,196,.35); background: rgba(7,217,196,.08); color: #07d9c4; }
    .proposal-row { animation: proposal-in 450ms both; }
    .proposal-row[hidden] { display: none; }
    .form-field { display: flex; flex-direction: column; gap: 0.55rem; color: rgba(255,255,255,.72); font-size: .8rem; font-weight: 700; }
    .form-field :is(input, textarea) { width: 100%; border: 1px solid rgba(255,255,255,.1); border-radius: 1rem; background: rgba(0,0,0,.22); padding: .9rem 1rem; color: white; font: inherit; font-weight: 400; outline: none; transition: border-color 160ms, box-shadow 160ms; }
    .form-field textarea { resize: vertical; min-height: 10rem; max-height: 24rem; line-height: 1.6; }
    .form-field :is(input, textarea)::placeholder { color: rgba(255,255,255,.3); }
    .form-field :is(input, textarea):focus { border-color: rgba(7,217,196,.7); box-shadow: 0 0 0 3px rgba(7,217,196,.1); }
    @keyframes proposal-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .proposal-row { animation: none; } }
</style>
