---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../../i18n";
import { platformPages, seoUi } from "../../../data/seo-pages";

export function getStaticPaths() {
    return locales.map((locale) => ({ params: { lang: locale } }));
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const ui = seoUi[locale];

const pageSeo = {
    title: `${ui.platformHubTitle} | App Vallax`,
    description: ui.platformHubDescription,
};
---

<LandingLayout lang={locale} seo={pageSeo} navbar={t.navbar} footer={t.footer}>
    <section class="bg-background/80 px-6 pb-24 pt-36 text-white md:px-16">
        <div class="mx-auto max-w-6xl">
            <header class="mb-12 text-center">
                <p class="text-xs uppercase tracking-[0.25em] text-primary/80">
                    Vallax SEO
                </p>
                <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
                    {ui.platformHubTitle}
                </h1>
                <p class="mx-auto mt-4 max-w-3xl text-white/70">
                    {ui.platformHubDescription}
                </p>
            </header>

            <div class="grid gap-6 md:grid-cols-2">
                {
                    platformPages.map((page) => {
                        const item = page.locale[locale];
                        return (
                            <a
                                href={`/${locale}/platforms/${page.slug}/`}
                                class="group rounded-3xl border border-white/10 bg-white/5 p-8 transition hover:border-primary/50 hover:bg-white/10"
                            >
                                <h2 class="text-2xl font-semibold text-white">
                                    {item.title}
                                </h2>
                                <p class="mt-4 text-white/70">
                                    {item.description}
                                </p>
                                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-primary">
                                    {ui.cardCta}
                                    <span class="material-symbols-outlined text-base">
                                        arrow_forward
                                    </span>
                                </span>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>
</LandingLayout>
