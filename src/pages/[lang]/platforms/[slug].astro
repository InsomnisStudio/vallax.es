---
import LandingLayout from "../../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../../i18n";
import { platformPages, seoUi } from "../../../data/seo-pages";
import WallapopLogo from "../../../images/wallapop.png";
import VintedLogo from "../../../images/vinted.png";
import MilanunciosLogo from "../../../images/milanuncios.png";
import TodocoleccionLogo from "../../../images/todocoleccion.png";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return locales.flatMap((locale) =>
        platformPages.map((page) => ({
            params: { lang: locale, slug: page.slug },
        })),
    );
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const ui = seoUi[locale];
const slug = Astro.params.slug ?? "";
const currentPage = platformPages.find((page) => page.slug === slug);

if (!currentPage) {
    throw new Error(`Unknown platform page: ${slug}`);
}

const copy = currentPage.locale[locale];
const relatedPages = platformPages.filter((page) => page.slug !== slug).slice(0, 3);
const homeHref = `/${locale}/`;
const pageSeo = {
    title: copy.title,
    description: copy.description,
};
const platformNameBySlug: Record<string, string> = {
    "wallapop-alerts": "Wallapop",
    "vinted-alerts": "Vinted",
    "milanuncios-alerts": "Milanuncios",
    "todocoleccion-alerts": "Todocolección",
};
const platformName = platformNameBySlug[currentPage.slug] ?? currentPage.slug;
const platformLogoBySlug: Record<string, ImageMetadata> = {
    "wallapop-alerts": WallapopLogo,
    "vinted-alerts": VintedLogo,
    "milanuncios-alerts": MilanunciosLogo,
    "todocoleccion-alerts": TodocoleccionLogo,
};
const platformLogo = platformLogoBySlug[currentPage.slug];
const detailUi: Record<Locale, { signal: string; live: string; sequence: string; ctaNote: string }> = {
    es: { signal: "Nueva oportunidad detectada", live: "ahora", sequence: "Así te pone Vallax por delante", ctaNote: "Disponible para iOS y Android" },
    en: { signal: "New opportunity detected", live: "now", sequence: "How Vallax puts you ahead", ctaNote: "Available for iOS and Android" },
    fr: { signal: "Nouvelle opportunité détectée", live: "maintenant", sequence: "Comment Vallax vous donne une longueur d'avance", ctaNote: "Disponible sur iOS et Android" },
    it: { signal: "Nuova opportunità rilevata", live: "ora", sequence: "Come Vallax ti porta in vantaggio", ctaNote: "Disponibile per iOS e Android" },
    pl: { signal: "Wykryto nową okazję", live: "teraz", sequence: "Jak Vallax daje Ci przewagę", ctaNote: "Dostępne na iOS i Android" },
};
const detail = detailUi[locale];
const blogSlugsByPlatform: Record<string, string[]> = {
    "wallapop-alerts": ["ps5-barata-segunda-mano", "wallapop-vs-vinted-vs-milanuncios"],
    "vinted-alerts": ["ps5-barata-segunda-mano", "wallapop-vs-vinted-vs-milanuncios"],
    "milanuncios-alerts": ["wallapop-vs-vinted-vs-milanuncios"],
    "todocoleccion-alerts": ["wallapop-vs-vinted-vs-milanuncios"],
};
const relatedPosts = locale === "es"
    ? (await getCollection("blog")).filter((post) =>
          blogSlugsByPlatform[currentPage.slug]?.includes(post.id.replace(/\.md$/, "")),
      )
    : [];
const nonAffiliation: Record<Locale, string> = {
    es: `Vallax es una aplicación independiente. Esta página no está afiliada ni respaldada por ${platformName}.`,
    en: `Vallax is an independent application. This page is not affiliated with or endorsed by ${platformName}.`,
    fr: `Vallax est une application indépendante. Cette page n'est ni affiliée ni approuvée par ${platformName}.`,
    it: `Vallax è un'applicazione indipendente. Questa pagina non è affiliata né approvata da ${platformName}.`,
    pl: `Vallax jest niezależną aplikacją. Ta strona nie jest powiązana ani wspierana przez ${platformName}.`,
};
---

<LandingLayout lang={locale} seo={pageSeo} navbar={t.navbar} footer={t.footer}>
    <section class="seo-detail-hero relative overflow-hidden px-6 pb-24 pt-36 text-white md:px-16 md:pb-32 md:pt-44">
        <div class="seo-orbit seo-orbit-one" aria-hidden="true"></div>
        <div class="seo-orbit seo-orbit-two" aria-hidden="true"></div>
        <div class="relative mx-auto grid max-w-7xl gap-16 lg:grid-cols-[1.12fr_0.88fr] lg:items-center">
            <header>
                <a href={`/${locale}/platforms/`} class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.24em] text-primary">
                    <span class="h-px w-8 bg-primary"></span>{ui.platformGroupTitle}
                </a>
                <h1 class="mt-8 max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.055em] md:text-7xl">
                    {copy.title}
                </h1>
                <p class="mt-8 max-w-2xl text-lg leading-8 text-white/65 md:text-xl">{copy.description}</p>
                <a href={`${homeHref}#download-app`} class="mt-10 inline-flex items-center gap-3 border-b-2 border-primary pb-2 font-black text-white transition hover:text-primary">
                    {copy.cta}<span class="material-symbols-outlined">arrow_outward</span>
                </a>
            </header>

            <div class="relative mx-auto w-full max-w-md py-10 lg:ml-auto">
                <div class="seo-radar" aria-hidden="true"><span></span><span></span><span></span></div>
                <div class="seo-notification relative z-10">
                    <div class="flex items-center gap-4">
                        {platformLogo && <img src={platformLogo.src} width="48" height="48" alt="" class="h-12 w-12 object-contain" />}
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-4">
                                <p class="font-black text-white">Vallax</p>
                                <span class="text-xs text-white/40">{detail.live}</span>
                            </div>
                            <p class="mt-1 text-sm text-white/55">{detail.signal}</p>
                        </div>
                    </div>
                    <div class="mt-7 border-t border-white/10 pt-6">
                        <p class="text-2xl font-black text-white">{platformName}</p>
                        <div class="mt-3 flex items-center gap-2 text-sm text-primary">
                            <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
                            <span>{copy.bullets[0]}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="border-y border-white/5 bg-black/20 px-6 py-24 text-white md:px-16 md:py-32">
        <div class="mx-auto grid max-w-7xl gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.24em] text-secondary">{ui.keyPointsTitle}</p>
                <h2 class="mt-5 text-3xl font-black leading-tight tracking-tight md:text-5xl">{detail.sequence}</h2>
                <p class="mt-7 max-w-md text-lg leading-8 text-white/60">{copy.intro}</p>
            </div>
            <ol class="border-t border-white/12">
                {copy.bullets.map((bullet, index) => (
                    <li class="group grid grid-cols-[3rem_1fr] gap-5 border-b border-white/12 py-8 md:grid-cols-[5rem_1fr] md:py-10">
                        <span class="font-black text-primary/60 transition group-hover:text-primary">0{index + 1}</span>
                        <p class="text-xl font-bold leading-8 text-white md:text-2xl">{bullet}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="px-6 py-24 text-white md:px-16 md:py-32">
        <div class="mx-auto max-w-7xl">
            <div class="seo-cta-stripe relative overflow-hidden px-7 py-12 md:px-14 md:py-16">
                <p class="text-xs font-black uppercase tracking-[0.24em] text-on-primary/60">{detail.ctaNote}</p>
                <div class="mt-4 flex flex-col justify-between gap-8 md:flex-row md:items-end">
                    <h2 class="max-w-3xl text-4xl font-black leading-tight tracking-tight text-on-primary md:text-6xl">{copy.cta}</h2>
                    <a href={`${homeHref}#download-app`} class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-on-primary text-primary transition hover:rotate-12 hover:scale-105" aria-label={copy.cta}>
                        <span class="material-symbols-outlined text-3xl">arrow_outward</span>
                    </a>
                </div>
            </div>

            {relatedPosts.length > 0 && (
                <div class="mt-24">
                    <p class="text-xs font-black uppercase tracking-[0.2em] text-secondary">Artículos relacionados</p>
                    <div class="mt-5 border-t border-white/12">
                        {relatedPosts.map((post) => (
                            <a href={`/es/blog/${post.id.replace(/\.md$/, "")}/`} class="group flex items-center justify-between gap-8 border-b border-white/12 py-7">
                                <p class="text-lg font-bold text-white/75 transition group-hover:text-primary md:text-xl">{post.data.title}</p>
                                <span class="material-symbols-outlined text-white/30 transition group-hover:text-primary">north_east</span>
                            </a>
                        ))}
                    </div>
                </div>
            )}

            <div class="mt-24">
                <div class="flex items-end justify-between gap-6 border-b border-white/12 pb-5">
                    <h2 class="text-2xl font-black md:text-3xl">{ui.relatedTitle}</h2>
                    <a href={`/${locale}/solutions/`} class="hidden text-sm font-bold text-primary md:block">{ui.openGroup} {ui.solutionGroupTitle.toLowerCase()} →</a>
                </div>
                <div>
                    {relatedPages.map((page, index) => (
                        <a href={`/${locale}/platforms/${page.slug}/`} class="group grid gap-3 border-b border-white/12 py-7 transition md:grid-cols-[4rem_1fr_auto] md:items-center md:py-9">
                            <span class="text-xs font-black text-white/30">0{index + 1}</span>
                            <p class="text-xl font-bold text-white transition group-hover:text-primary md:text-2xl">{page.locale[locale].title}</p>
                            <span class="material-symbols-outlined text-white/35 transition group-hover:translate-x-2 group-hover:text-primary">arrow_forward</span>
                        </a>
                    ))}
                </div>
                <p class="mt-8 max-w-3xl text-xs leading-5 text-white/35">{nonAffiliation[locale]}</p>
            </div>
        </div>
    </section>
</LandingLayout>
