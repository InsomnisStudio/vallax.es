---
import HomePage from "../../components/landing/HomePage.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../i18n";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale } }));
}

// Landing for paid ads: same home page with a conversion-focused hero.
const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
---

<LandingLayout
  lang={locale}
  seo={t.seo}
  navbar={t.navbar}
  footer={t.footer}
  noindex
>
  <HomePage lang={locale} t={t} variant="ad" />
</LandingLayout>
