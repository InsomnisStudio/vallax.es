---
import HomePage from "../../components/landing/HomePage.astro";
import LandingLayout from "../../layouts/LandingLayout.astro";
import { translations, isLocale, locales, type Locale } from "../../i18n";
import { featuredReviews, googlePlayUrl } from "../../data/reviews";
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { lang: locale } }));
}

const paramLang = Astro.params.lang;
const locale: Locale = isLocale(paramLang) ? paramLang : "es";
const t = translations[locale];
const organizationId = "https://vallax.es/#organization";
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": organizationId,
    name: "Vallax",
    url: "https://vallax.es/",
    logo: "https://vallax.es/vallax-logo.svg",
    email: "vallaxdev@gmail.com",
    description: t.seo.description,
    sameAs: [
      "https://apps.apple.com/es/app/vallax/id6793169829",
      googlePlayUrl,
      "https://www.youtube.com/@vallax-app",
      "https://t.me/vallax_group",
      ...t.footer.socials.map((social) => social.href),
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://vallax.es/#website",
    name: "Vallax",
    url: "https://vallax.es/",
    inLanguage: locales,
    publisher: { "@id": organizationId },
  },
  {
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    name: "Vallax",
    alternateName: "Vallax: alertas de Wallapop y Vinted",
    description: t.seo.description,
    applicationCategory: "ShoppingApplication",
    operatingSystem: "iOS, Android",
    inLanguage: locale,
    url: `https://vallax.es/${locale}/`,
    publisher: { "@id": organizationId },
    downloadUrl: [
      "https://apps.apple.com/es/app/vallax/id6793169829",
      googlePlayUrl,
    ],
    featureList: t.features.features.map(
      (feature) => `${feature.title}: ${feature.description}`,
    ),
    offers: [
      { "@type": "Offer", name: "Gratis", price: "0", priceCurrency: "EUR" },
      { "@type": "Offer", name: "Plus", price: "3.99", priceCurrency: "EUR" },
      { "@type": "Offer", name: "Pro", price: "11.99", priceCurrency: "EUR" },
    ],
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: "4.25",
      ratingCount: "4",
      bestRating: "5",
      worstRating: "1",
    },
    review: featuredReviews.map((review) => ({
      "@type": "Review",
      author: { "@type": "Person", name: review.author },
      datePublished: review.datePublished,
      reviewBody: review.body,
      inLanguage: review.language,
      url: googlePlayUrl,
      reviewRating: {
        "@type": "Rating",
        ratingValue: String(review.rating),
        bestRating: "5",
        worstRating: "1",
      },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.faq.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<LandingLayout
  lang={locale}
  seo={t.seo}
  navbar={t.navbar}
  footer={t.footer}
  structuredData={structuredData}
>
  <HomePage lang={locale} t={t} />
</LandingLayout>
