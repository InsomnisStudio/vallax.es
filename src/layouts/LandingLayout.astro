---
import "/src/assets/css/styles.css";
import Navbar from "../components/sections/Navbar.astro";
import Footer from "../components/sections/Footer.astro";
import { locales, type Translation, type Locale } from "../i18n";

interface Props {
    lang: Locale;
    seo: Translation["seo"];
    navbar: Translation["navbar"];
    footer: Translation["footer"];
    faq?: Translation["faq"];
}

const { lang, seo, navbar, footer, faq } = Astro.props as Props;
const site = Astro.site ?? new URL("https://vallax.es");
const hreflangByLocale: Record<Locale, string> = {
    es: "es-ES",
    en: "en",
    fr: "fr-FR",
    it: "it-IT",
    pl: "pl-PL",
};
const pathname = Astro.url.pathname;
const pathWithoutLocale =
    pathname === `/${lang}` || pathname === `/${lang}/`
        ? "/"
        : pathname.startsWith(`/${lang}/`)
          ? pathname.slice(`/${lang}`.length)
          : "/";
const localeAlternates = locales.map((locale) => {
    const localizedPath = `/${locale}${pathWithoutLocale}`;
    return {
        locale,
        hreflang: hreflangByLocale[locale],
        url: new URL(localizedPath, site),
    };
});
const canonical = new URL(`/${lang}${pathWithoutLocale}`, site);
---

<!doctype html>
<html lang={lang}>
    <head>
        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=AW-17380125186"
        ></script>

        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            window.gtag = function () {
                window.dataLayer.push(arguments);
            };

            window.gtag("js", new Date());
            window.gtag("config", "AW-17380125186");
        </script>

        <script is:inline>
            window.gtag_report_conversion = function (url) {
                console.log("here");
                var callback = function () {
                    if (typeof url !== "undefined") {
                        window.location = url;
                    }
                };
                gtag("event", "conversion", {
                    send_to: "AW-17380125186/RPLmCP3VwPIbEILUvt9A",
                    value: 1.0,
                    currency: "EUR",
                    event_callback: callback,
                });
                return false;
            };
        </script>

        <!-- Charset & Viewport -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{seo.title}</title>
        <meta name="description" content={seo.description} />
        <link rel="canonical" href={canonical.toString()} />
        {
            localeAlternates.map((alternate) => (
                <link
                    rel="alternate"
                    hreflang={alternate.hreflang}
                    href={alternate.url.toString()}
                />
            ))
        }
        <link
            rel="alternate"
            hreflang="x-default"
            href={new URL("/es/", site).toString()}
        />

        <meta name="robots" content="index,follow,max-image-preview:large" />
        <meta name="googlebot" content="index,follow" />

        <!-- Dark mode favicon -->
        <link
            rel="icon"
            href="/favicon-d.svg"
            media="(prefers-color-scheme: dark)"
        />
        <!-- Light mode favicon -->
        <link
            rel="icon"
            href="/favicon-l.svg"
            media="(prefers-color-scheme: light)"
        />

        <meta name="theme-color" content="#07D9C4" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <header>
            <Navbar t={navbar} lang={lang} />
        </header>
        <main>
            <slot />
        </main>
        <Footer t={footer} />
        <script src="../main.js"></script>
    </body>
</html>
